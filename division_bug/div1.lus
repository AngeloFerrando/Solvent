
node Division (c:int;) returns();
const starting_v1 : int = 0;
const starting_v2 : int = 0;
var v1 : int;
var v2 : int;
let
    if ((starting_v2 -> pre v2) > 0) then
    	v1 = (starting_v1 -> pre v1)/(starting_v2 -> pre v2);
    	v2 = (starting_v2 -> pre v2);
    else
        v1 = v1 + c;
        v2 = v2 + c;
	fi

--%PROPERTY 
not(v1=1);

tel
        
