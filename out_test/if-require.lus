
type functions = enum { dummy, set_v_func };
type address = enum { a1, a2 };
node IfRequire (xa:address;xn:int;f:functions;constructor_initial_v:int;set_v_func_new_v:int;starting_w: int;starting_aw_1: int;starting_aw_2: int) returns();
(*@contract
    assume starting_w >= 0;
    assume starting_aw_1 >= 0;
assume starting_aw_2 >= 0;
*)
var contract_not_constructed: bool;
const starting_err : bool = false;
const starting_block_num : int = 0;
const starting_v : int = 0;
var w: int;
var w_0: int;
var aw_1: int;
var aw_2: int;
var aw_1_0: int;
var aw_2_0: int;
var err : bool;
var err_0 : bool;
var err_1 : bool;
var block_num : int;
var v : int;
var v_0 : int;
let
    if (true -> pre contract_not_constructed) then
if (not(xn >= 0 and (xa = a1 or xa = a2) and ((not(xa = a1) or (starting_aw_1 -> pre aw_1) >= xn) and (not(xa = a2) or (starting_aw_2 -> pre aw_2) >= xn)))) then err_0=true; else err_0=false; fi
w_0 = (starting_w -> pre w) + xn;
if (xa = a1) then
	aw_1_0 = (starting_aw_1 -> pre aw_1) - xn;
	aw_2_0 = (starting_aw_2 -> pre aw_2);
else
	aw_1_0 = (starting_aw_1 -> pre aw_1);
	aw_2_0 = (starting_aw_2 -> pre aw_2) - xn;
fi

if (not(xn>0)) then err_1=true; else err_1=err_0; fi

v_0 = xn; if (err_1) then 
	w = (starting_w -> pre w);
	aw_1 = (starting_aw_1 -> pre aw_1);
	aw_2 = (starting_aw_2 -> pre aw_2);
	v = (starting_v -> pre v);
	
	contract_not_constructed = true;
	block_num = any {block_num_tmp: int | block_num_tmp > (starting_block_num -> pre block_num)}; else 
	w = w_0;
	aw_1 = aw_1_0;
	aw_2 = aw_2_0;
	v = v_0;
	
	contract_not_constructed = false;
	block_num = any {block_num_tmp: int | block_num_tmp > (starting_block_num -> pre block_num)};
fi
elsif f = set_v_func then
	if (not(xn >= 0 and (xa = a1 or xa = a2) and ((not(xa = a1) or (starting_aw_1 -> pre aw_1) >= xn) and (not(xa = a2) or (starting_aw_2 -> pre aw_2) >= xn)))) then err_0=true; else err_0=false; fi
w_0 = (starting_w -> pre w) + xn;
if (xa = a1) then
	aw_1_0 = (starting_aw_1 -> pre aw_1) - xn;
	aw_2_0 = (starting_aw_2 -> pre aw_2);
else
	aw_1_0 = (starting_aw_1 -> pre aw_1);
	aw_2_0 = (starting_aw_2 -> pre aw_2) - xn;
fi

if (set_v_func_new_v>10) then if (not(xn = 100)) then err_1=true; else err_1=err_0; fi

v_0 = set_v_func_new_v; else if (not(xn = 1)) then err_1=true; else err_1=err_0; fi

v_0 = set_v_func_new_v; fi if (err_1) then 
	w = (starting_w -> pre w);
	aw_1 = (starting_aw_1 -> pre aw_1);
	aw_2 = (starting_aw_2 -> pre aw_2);
	v = (starting_v -> pre v);
	
	contract_not_constructed = (true -> pre contract_not_constructed);
	block_num = any {block_num_tmp: int | block_num_tmp > (starting_block_num -> pre block_num)}; else 
	w = w_0;
	aw_1 = aw_1_0;
	aw_2 = aw_2_0;
	v = v_0;
	
	contract_not_constructed = (true -> pre contract_not_constructed);
	block_num = any {block_num_tmp: int | block_num_tmp > (starting_block_num -> pre block_num)};
fi
else
	block_num = any {block_num_tmp: int | block_num_tmp > (starting_block_num -> pre block_num)};
	w = (starting_w -> pre w);
	aw_1 = (starting_aw_1 -> pre aw_1);
	aw_2 = (starting_aw_2 -> pre aw_2);
	err = (starting_err -> pre err);
	v = (starting_v -> pre v);
	
fi
    --%PROPERTY 
(
contract_not_constructed or 
(true)
);

--%PROPERTY 
(
contract_not_constructed or 
(forall(v1_tx:int;)forall(addr_tx:address;)exists(qfa_tx:functions;)exists(msgvalue_tx:int;)
    exists (
        xa_tx1: address; f_tx1: functions; constructor_initial_v_tx1: int; set_v_func_new_v_tx1: int; xn_tx1: int;  /* Transition vars */
        w_nx1: int; w_0_nx1: int; aw_1_nx1: int; aw_2_nx1: int; aw_1_0_nx1: int; aw_2_0_nx1: int; err_nx1 : bool; err_0_nx1 : bool; err_1_nx1 : bool; err_2_nx1 : bool; err_3_nx1 : bool; block_num_nx1 : int; block_num_0_nx1 : int; v_nx1 : int; v_0_nx1 : int; v_1_nx1 : int; /* Next state vars */
    )
    (   /* condition */
        v_nx1 = v1_tx
        and
        (
            ((xa_tx1 = addr_tx and f_tx1 = qfa_tx and xn_tx1 = msgvalue_tx) and 
if f_tx1 = set_v_func then
(if (not(xn_tx1 >= 0 and (xa_tx1 = a1 or xa_tx1 = a2) and ((not(xa_tx1 = a1) or aw_1 >= xn_tx1) and (not(xa_tx1 = a2) or aw_2 >= xn_tx1)))) then err_0_nx1=true else err_0_nx1=false)
 and (w_0_nx1 = w + xn_tx1 and
if (xa_tx1 = a1) then
	aw_1_0_nx1 = aw_1 - xn_tx1 and
	aw_2_0_nx1 = aw_2
else
	aw_1_0_nx1 = aw_1 and
	aw_2_0_nx1 = aw_2 - xn_tx1
) and 
(if set_v_func_new_v_tx1>10 then (if (not(xn_tx1 = 100)) then err_1_nx1=true else err_1_nx1=err_0_nx1)
 and v_0_nx1 = set_v_func_new_v_tx1 else (if (not(xn_tx1 = 1)) then err_1_nx1=true else err_1_nx1=err_0_nx1)
 and v_0_nx1 = set_v_func_new_v_tx1) and if (err_1_nx1) then 

	w_nx1 = w and 
	aw_1_nx1 = aw_1
	 and aw_2_nx1 = aw_2 and 
	v_nx1 = v and 
	true and block_num >= block_num else  
	w_nx1 = w_0_nx1 and 
	aw_1_nx1 = aw_1_0_nx1
	 and aw_2_nx1 = aw_2_0_nx1 and 
	v_nx1 = v_0_nx1 and 
	true and block_num >= block_num

else block_num_nx1 >= block_num and 
	w_nx1 = w  and 
	aw_1_nx1 = aw_1
	and aw_2_nx1 = aw_2 and 
	err_nx1 = err
	 and block_num_nx1 = block_num
	 and v_nx1 = v and 
	true
)
        )
    ))
);

--%PROPERTY 
(
contract_not_constructed or 
(forall(v1_tx:int;)forall(addr_tx:address;)(not(if addr_tx = a1 then aw_1 > 100
	else aw_2 > 100
	) or exists(qfa_tx:functions;)exists(msgvalue_tx:int;)
    exists (
        xa_tx1: address; f_tx1: functions; constructor_initial_v_tx1: int; set_v_func_new_v_tx1: int; xn_tx1: int;  /* Transition vars */
        w_nx1: int; w_0_nx1: int; aw_1_nx1: int; aw_2_nx1: int; aw_1_0_nx1: int; aw_2_0_nx1: int; err_nx1 : bool; err_0_nx1 : bool; err_1_nx1 : bool; err_2_nx1 : bool; err_3_nx1 : bool; block_num_nx1 : int; block_num_0_nx1 : int; v_nx1 : int; v_0_nx1 : int; v_1_nx1 : int; /* Next state vars */
    )
    (   /* condition */
        v_nx1 = v1_tx
        and
        (
            ((xa_tx1 = addr_tx and f_tx1 = qfa_tx and xn_tx1 = msgvalue_tx) and 
if f_tx1 = set_v_func then
(if (not(xn_tx1 >= 0 and (xa_tx1 = a1 or xa_tx1 = a2) and ((not(xa_tx1 = a1) or aw_1 >= xn_tx1) and (not(xa_tx1 = a2) or aw_2 >= xn_tx1)))) then err_0_nx1=true else err_0_nx1=false)
 and (w_0_nx1 = w + xn_tx1 and
if (xa_tx1 = a1) then
	aw_1_0_nx1 = aw_1 - xn_tx1 and
	aw_2_0_nx1 = aw_2
else
	aw_1_0_nx1 = aw_1 and
	aw_2_0_nx1 = aw_2 - xn_tx1
) and 
(if set_v_func_new_v_tx1>10 then (if (not(xn_tx1 = 100)) then err_1_nx1=true else err_1_nx1=err_0_nx1)
 and v_0_nx1 = set_v_func_new_v_tx1 else (if (not(xn_tx1 = 1)) then err_1_nx1=true else err_1_nx1=err_0_nx1)
 and v_0_nx1 = set_v_func_new_v_tx1) and if (err_1_nx1) then 

	w_nx1 = w and 
	aw_1_nx1 = aw_1
	 and aw_2_nx1 = aw_2 and 
	v_nx1 = v and 
	true and block_num >= block_num else  
	w_nx1 = w_0_nx1 and 
	aw_1_nx1 = aw_1_0_nx1
	 and aw_2_nx1 = aw_2_0_nx1 and 
	v_nx1 = v_0_nx1 and 
	true and block_num >= block_num

else block_num_nx1 >= block_num and 
	w_nx1 = w  and 
	aw_1_nx1 = aw_1
	and aw_2_nx1 = aw_2 and 
	err_nx1 = err
	 and block_num_nx1 = block_num
	 and v_nx1 = v and 
	true
)
        )
    )))
);

tel
        