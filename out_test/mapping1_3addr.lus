if f_tx1 = foo_func then

if (xa = a1) then 
 ((if (not(not(xa_tx1=aMapping1))) then lastReverted_0_nx1=true else lastReverted_0_nx1=false)
 and (if (not(xn_tx1 = 0)) then lastReverted_1_nx1=true else lastReverted_1_nx1=lastReverted_0_nx1)
 and m_1_nx1_0 = (m_1+1)) 
 else if (xa = a2) then 
((if (not(not(xa_tx1=aMapping1))) then lastReverted_0_nx1=true else lastReverted_0_nx1=false)
 and (if (not(xn_tx1 = 0)) then lastReverted_1_nx1=true else lastReverted_1_nx1=lastReverted_0_nx1)
 and m_2_nx1_0 = (m_2+1)) 
 else 
((if (not(not(xa_tx1=aMapping1))) then lastReverted_0_nx1=true else lastReverted_0_nx1=false)
 and (if (not(xn_tx1 = 0)) then lastReverted_1_nx1=true else lastReverted_1_nx1=lastReverted_0_nx1)
 and m_3_nx1_0 = (m_3+1)) and if (lastReverted_1_nx1) then 

	aw_Mapping1_nx1 = aw_Mapping1 and 
	aw_1_nx1 = aw_1
	 and aw_2_nx1 = aw_2
	 and aw_3_nx1 = aw_3 and 
	true and 
	m_1_nx1 = m_1
	 and m_2_nx1 = m_2
	 and m_3_nx1 = m_3 and block_num >= block_num else  
	aw_Mapping1_nx1 = aw_Mapping1 and 
	aw_1_nx1 = aw_1
	 and aw_2_nx1 = aw_2
	 and aw_3_nx1 = aw_3 and 
	true and 
	m_1_nx1 = m_1_nx1_0
	 and m_2_nx1 = m_2_nx1_0
	 and m_3_nx1 = m_3_nx1_0 and block_num >= block_num

else block_num_nx1 >= block_num and 
	aw_Mapping1_nx1 = aw_Mapping1 and 
	aw_1_nx1 = aw_1
	and aw_2_nx1 = aw_2
	and aw_3_nx1 = aw_3 and 
	lastReverted_nx1 = lastReverted
	 and block_num_nx1 = block_num and 
	m_1_nx1 = m_1
	 and m_2_nx1 = m_2
	 and m_3_nx1 = m_3
)
        )
    ))))
);

--%PROPERTY 
(
contract_not_constructed or 
(forall(a_tx:address;)((a_tx = aMapping1) or (exists(h1_tx:functions;)exists(h2_tx:functions;)
    exists (
        xa_tx1: address; f_tx1: functions;  xn_tx1: int;  /* Transition vars */
        aw_Mapping1_nx1: int; aw_1_nx1: int; aw_2_nx1: int; aw_3_nx1: int; lastReverted_nx1 : bool; lastReverted_0_nx1 : bool; lastReverted_1_nx1 : bool; lastReverted_2_nx1 : bool; lastReverted_3_nx1 : bool; block_num_nx1 : int; block_num_0_nx1 : int; m_1_nx1 : int; m_2_nx1 : int; m_3_nx1 : int; m_1_nx1_0 : int; m_2_nx1_0 : int; m_3_nx1_0 : int; /* Next state vars */
    )
    (   /* condition */
        
    exists (
        xa_tx2: address; f_tx2: functions;  xn_tx2: int;  /* Transition vars */
        aw_Mapping1_nx2: int; aw_1_nx2: int; aw_2_nx2: int; aw_3_nx2: int; lastReverted_nx2 : bool; lastReverted_0_nx2 : bool; lastReverted_1_nx2 : bool; lastReverted_2_nx2 : bool; lastReverted_3_nx2 : bool; block_num_nx2 : int; block_num_0_nx2 : int; m_1_nx2 : int; m_2_nx2 : int; m_3_nx2 : int; m_1_nx2_0 : int; m_2_nx2_0 : int; m_3_nx2_0 : int; /* Next state vars */
    )
    (   /* condition */
        if a_tx = a1 then m_1_nx2 = (m_1+2)
	else if a = a2 then m_2_nx2 = (m_2+2)
	else m_3_nx2 = (m_3+2)
	
        and
        (
            ((xa_tx2 = a_tx and f_tx2 = h2_tx and true and xn_tx2 = 0) and 
if f_tx2 = foo_func then

if (xa_tx1 = a1) then 
 ((if (not(not(xa_tx2=aMapping1))) then lastReverted_0_nx2=true else lastReverted_0_nx2=false)
 and (if (not(xn_tx2 = 0)) then lastReverted_1_nx2=true else lastReverted_1_nx2=lastReverted_0_nx2)
 and m_1_nx2_0 = (m_1_nx1+1)) 
 else if (xa_tx1 = a2) then 
((if (not(not(xa_tx2=aMapping1))) then lastReverted_0_nx2=true else lastReverted_0_nx2=false)
 and (if (not(xn_tx2 = 0)) then lastReverted_1_nx2=true else lastReverted_1_nx2=lastReverted_0_nx2)
 and m_2_nx2_0 = (m_2_nx1+1)) 
 else 
((if (not(not(xa_tx2=aMapping1))) then lastReverted_0_nx2=true else lastReverted_0_nx2=false)
 and (if (not(xn_tx2 = 0)) then lastReverted_1_nx2=true else lastReverted_1_nx2=lastReverted_0_nx2)
 and m_3_nx2_0 = (m_3_nx1+1)) and if (lastReverted_1_nx2) then 

	aw_Mapping1_nx2 = aw_Mapping1_nx1 and 
	aw_1_nx2 = aw_1_nx1
	 and aw_2_nx2 = aw_2_nx1
	 and aw_3_nx2 = aw_3_nx1 and 
	true and 
	m_1_nx2 = m_1_nx1
	 and m_2_nx2 = m_2_nx1
	 and m_3_nx2 = m_3_nx1 and block_num_nx2 >= block_num else  
	aw_Mapping1_nx2 = aw_Mapping1_nx1 and 
	aw_1_nx2 = aw_1_nx1
	 and aw_2_nx2 = aw_2_nx1
	 and aw_3_nx2 = aw_3_nx1 and 
	true and 
	m_1_nx2 = m_1_nx2_0
	 and m_2_nx2 = m_2_nx2_0
	 and m_3_nx2 = m_3_nx2_0 and block_num_nx2 >= block_num

else block_num_nx2 >= block_num and 
	aw_Mapping1_nx2 = aw_Mapping1_nx1  and 
	aw_1_nx2 = aw_1_nx1
	and aw_2_nx2 = aw_2_nx1
	and aw_3_nx2 = aw_3_nx1 and 
	lastReverted_nx2 = lastReverted_nx1 and 
	m_1_nx2 = m_1_nx1
	 and m_2_nx2 = m_2_nx1
	 and m_3_nx2 = m_3_nx1
)
        )
    )
        and
        (
            ((xa_tx1 = a_tx and f_tx1 = h1_tx and true and xn_tx1 = 0) and 
if f_tx1 = foo_func then

if (xa = a1) then 
 ((if (not(not(xa_tx1=aMapping1))) then lastReverted_0_nx1=true else lastReverted_0_nx1=false)
 and (if (not(xn_tx1 = 0)) then lastReverted_1_nx1=true else lastReverted_1_nx1=lastReverted_0_nx1)
 and m_1_nx1_0 = (m_1+1)) 
 else if (xa = a2) then 
((if (not(not(xa_tx1=aMapping1))) then lastReverted_0_nx1=true else lastReverted_0_nx1=false)
 and (if (not(xn_tx1 = 0)) then lastReverted_1_nx1=true else lastReverted_1_nx1=lastReverted_0_nx1)
 and m_2_nx1_0 = (m_2+1)) 
 else 
((if (not(not(xa_tx1=aMapping1))) then lastReverted_0_nx1=true else lastReverted_0_nx1=false)
 and (if (not(xn_tx1 = 0)) then lastReverted_1_nx1=true else lastReverted_1_nx1=lastReverted_0_nx1)
 and m_3_nx1_0 = (m_3+1)) and if (lastReverted_1_nx1) then 

	aw_Mapping1_nx1 = aw_Mapping1 and 
	aw_1_nx1 = aw_1
	 and aw_2_nx1 = aw_2
	 and aw_3_nx1 = aw_3 and 
	true and 
	m_1_nx1 = m_1
	 and m_2_nx1 = m_2
	 and m_3_nx1 = m_3 and block_num >= block_num else  
	aw_Mapping1_nx1 = aw_Mapping1 and 
	aw_1_nx1 = aw_1
	 and aw_2_nx1 = aw_2
	 and aw_3_nx1 = aw_3 and 
	true and 
	m_1_nx1 = m_1_nx1_0
	 and m_2_nx1 = m_2_nx1_0
	 and m_3_nx1 = m_3_nx1_0 and block_num >= block_num

else block_num_nx1 >= block_num and 
	aw_Mapping1_nx1 = aw_Mapping1 and 
	aw_1_nx1 = aw_1
	and aw_2_nx1 = aw_2
	and aw_3_nx1 = aw_3 and 
	lastReverted_nx1 = lastReverted
	 and block_num_nx1 = block_num and 
	m_1_nx1 = m_1
	 and m_2_nx1 = m_2
	 and m_3_nx1 = m_3
)
        )
    ))))
);

tel
        