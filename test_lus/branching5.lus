
type functions = enum { dummy, f_func,g_func };
type address = enum { a1, a2 };
node C (xa:int;xn:int;f:functions;starting_w: int;starting_aw_1: int;starting_aw_2: int) returns();
(*@contract
    assume starting_w >= 0;
    assume starting_aw_1 >= 0;
assume starting_aw_2 >= 0;
*)
var contract_not_constructed: bool;
const starting_err : bool = false;
const starting_block_num : int = 0;
const starting_v : int = 0;
var w: int;
var aw_1: int;
var aw_2: int;
var err : bool;
var block_num : int;
var v : int;
var v_0 : int;
let
    if (true -> pre contract_not_constructed) then

 if (false) then 
	w = (starting_w -> pre w);
	aw_1 = (starting_aw_1 -> pre aw_1);
	aw_2 = (starting_aw_2 -> pre aw_2);
	v = (starting_v -> pre v);
	
	contract_not_constructed = true;
	block_num = any {block_num_tmp: int | block_num_tmp > (starting_block_num -> pre block_num)}; else 
	w = (starting_w -> pre w);
	aw_1 = (starting_aw_1 -> pre aw_1);
	aw_2 = (starting_aw_2 -> pre aw_2);
	v = (starting_v -> pre v);
	
	contract_not_constructed = false;
	block_num = any {block_num_tmp: int | block_num_tmp > (starting_block_num -> pre block_num)};
fi
elsif f = f_func then
	
v_0 = 1; if (false) then 
	w = (starting_w -> pre w);
	aw_1 = (starting_aw_1 -> pre aw_1);
	aw_2 = (starting_aw_2 -> pre aw_2);
	v = (starting_v -> pre v);
	
	contract_not_constructed = (true -> pre contract_not_constructed);
	block_num = any {block_num_tmp: int | block_num_tmp > (starting_block_num -> pre block_num)}; else 
	w = (starting_w -> pre w);
	aw_1 = (starting_aw_1 -> pre aw_1);
	aw_2 = (starting_aw_2 -> pre aw_2);
	v = v_0;
	
	contract_not_constructed = (true -> pre contract_not_constructed);
	block_num = any {block_num_tmp: int | block_num_tmp > (starting_block_num -> pre block_num)};
fi
	elsif f = g_func then
	
v_0 = 2; if (false) then 
	w = (starting_w -> pre w);
	aw_1 = (starting_aw_1 -> pre aw_1);
	aw_2 = (starting_aw_2 -> pre aw_2);
	v = (starting_v -> pre v);
	
	contract_not_constructed = (true -> pre contract_not_constructed);
	block_num = any {block_num_tmp: int | block_num_tmp > (starting_block_num -> pre block_num)}; else 
	w = (starting_w -> pre w);
	aw_1 = (starting_aw_1 -> pre aw_1);
	aw_2 = (starting_aw_2 -> pre aw_2);
	v = v_0;
	
	contract_not_constructed = (true -> pre contract_not_constructed);
	block_num = any {block_num_tmp: int | block_num_tmp > (starting_block_num -> pre block_num)};
fi
else
	block_num = any {block_num_tmp: int | block_num_tmp > (starting_block_num -> pre block_num)};
	w = (starting_w -> pre w);
	aw_1 = (starting_aw_1 -> pre aw_1);
	aw_2 = (starting_aw_2 -> pre aw_2);
	err = (starting_err -> pre err);
	v = (starting_v -> pre v);
	
fi
    --%PROPERTY 
(
contract_not_constructed or 
(exists(z_tx:int;)forall(a_tx:address;)((
    exists (
        xa_tx1: address; f_tx1: functions;  xn_tx1: int;  /* Transition vars */
        w_nx1: int; aw_1_nx1: int; aw_2_nx1: int; err_nx1 : bool; err_0_nx1 : bool; err_1_nx1 : bool; block_num_nx1 : int; block_num_0_nx1 : int; v_nx1 : int; v_0_nx1 : int; v_1_nx1 : int; /* Next state vars */
    )
    (   /* condition */
        v_nx1 = z_tx
        and
        (
            ((xa_tx1 = a_tx and f_tx1 = f_func and xn_tx1 = 0) and 
if f_tx1 = f_func then
	
v_0_nx1 = 1 and if (false) then 

	w_nx1 = w and 
	aw_1_nx1 = aw_1
	 and aw_2_nx1 = aw_2 and 
	v_nx1 = v and 
	true and block_num_nx1 = any {block_num_tmp: int | block_num_tmp > block_num} else  
	w_nx1 = w and 
	aw_1_nx1 = aw_1
	 and aw_2_nx1 = aw_2 and 
	v_nx1 = v_0_nx1 and 
	true and block_num_nx1 = any {block_num_tmp: int | block_num_tmp > block_num}

	else if f_tx1 = g_func then
	
v_0_nx1 = 2 and if (false) then 

	w_nx1 = w and 
	aw_1_nx1 = aw_1
	 and aw_2_nx1 = aw_2 and 
	v_nx1 = v and 
	true and block_num_nx1 = any {block_num_tmp: int | block_num_tmp > block_num} else  
	w_nx1 = w and 
	aw_1_nx1 = aw_1
	 and aw_2_nx1 = aw_2 and 
	v_nx1 = v_0_nx1 and 
	true and block_num_nx1 = any {block_num_tmp: int | block_num_tmp > block_num}

else block_num_nx1 = any {block_num_tmp: int | block_num_tmp > block_num} and 
	w_nx1 = w  and 
	aw_1_nx1 = aw_1
	and aw_2_nx1 = aw_2 and 
	err_nx1 = err
	 and block_num_nx1 = block_num
	 and v_nx1 = v and 
	true
)
        )
    )) and (
    exists (
        xa_tx1: address; f_tx1: functions;  xn_tx1: int;  /* Transition vars */
        w_nx1: int; aw_1_nx1: int; aw_2_nx1: int; err_nx1 : bool; err_0_nx1 : bool; err_1_nx1 : bool; block_num_nx1 : int; block_num_0_nx1 : int; v_nx1 : int; v_0_nx1 : int; v_1_nx1 : int; /* Next state vars */
    )
    (   /* condition */
        v_nx1 = (z_tx+1)
        and
        (
            ((xa_tx1 = a_tx and f_tx1 = g_func and xn_tx1 = 0) and 
if f_tx1 = f_func then
	
v_0_nx1 = 1 and if (false) then 

	w_nx1 = w and 
	aw_1_nx1 = aw_1
	 and aw_2_nx1 = aw_2 and 
	v_nx1 = v and 
	true and block_num_nx1 = any {block_num_tmp: int | block_num_tmp > block_num} else  
	w_nx1 = w and 
	aw_1_nx1 = aw_1
	 and aw_2_nx1 = aw_2 and 
	v_nx1 = v_0_nx1 and 
	true and block_num_nx1 = any {block_num_tmp: int | block_num_tmp > block_num}

	else if f_tx1 = g_func then
	
v_0_nx1 = 2 and if (false) then 

	w_nx1 = w and 
	aw_1_nx1 = aw_1
	 and aw_2_nx1 = aw_2 and 
	v_nx1 = v and 
	true and block_num_nx1 = any {block_num_tmp: int | block_num_tmp > block_num} else  
	w_nx1 = w and 
	aw_1_nx1 = aw_1
	 and aw_2_nx1 = aw_2 and 
	v_nx1 = v_0_nx1 and 
	true and block_num_nx1 = any {block_num_tmp: int | block_num_tmp > block_num}

else block_num_nx1 = any {block_num_tmp: int | block_num_tmp > block_num} and 
	w_nx1 = w  and 
	aw_1_nx1 = aw_1
	and aw_2_nx1 = aw_2 and 
	err_nx1 = err
	 and block_num_nx1 = block_num
	 and v_nx1 = v and 
	true
)
        )
    ))))
);

tel
        